# Copy to .env.local and fill in. Never commit .env.local.

# CoinMarketCap API key (server only)
CMC_API_KEY=
# startup during the event, basic after it closes
CMC_PLAN=startup

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Bearer token Vercel cron sends to /api/cron/refresh
CRON_SECRET=
