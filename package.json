{
  "name": "been-here-before",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "data:probe": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/probe.ts",
    "data:pull": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/pull-history.ts",
    "data:pull:map": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/pull-map.ts",
    "data:pull:global": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/pull-global.ts",
    "data:build": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/build-panel.ts && tsx --env-file-if-exists=.env.local --conditions=react-server scripts/load.ts",
    "data:calibrate": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/calibrate.ts",
    "data:precompute": "tsx scripts/precompute.ts",
    "data:prewarm": "tsx --env-file-if-exists=.env.local scripts/prewarm.ts",
    "data:market": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/refresh-market.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/functions": "3.11.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
